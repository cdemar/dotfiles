# Essentials: everything this setup's configs need. Installed by `make install`.
# Personal apps go in Brewfile.apps.

# Core: the dotfiles themselves need these
####
# Distributed revision control system
brew "git"
# Organize software neatly under a single directory tree (e.g. /usr/local)
brew "stow"
# GitHub command-line tool
brew "gh"


# Shell
####
# Theme for zsh
brew "powerlevel10k"
# Fish-like fast/unobtrusive autosuggestions for zsh
brew "zsh-autosuggestions"
# Fish shell like syntax highlighting for zsh
brew "zsh-syntax-highlighting"
# Shell extension to navigate your filesystem faster
brew "zoxide"
# Command-line fuzzy finder written in Go
brew "fzf"
# Modern, maintained replacement for ls
brew "eza"
# Official Amazon AWS command-line interface
brew "awscli"


# Neovim and the tools its plugins call
####
# Ambitious Vim-fork focused on extensibility and agility
brew "neovim"
# Search tool like grep and The Silver Searcher
brew "ripgrep"
# Simple, fast and user-friendly alternative to find
brew "fd"
# Builds the syntax parsers Neovim uses 
brew "tree-sitter-cli"
# Terminal UI for git
brew "lazygit"
# Fast and simple Node.js version manager
brew "fnm"



# Main Apps
####
# GPU-accelerated cross-platform terminal emulator and multiplexer
cask "wezterm"
# Font with the icons the prompt and Neovim use
cask "font-meslo-lg-nerd-font"
# Terminal-based AI coding assistant
cask "claude-code"
# Knowledge base that works on top of a local folder of plain text Markdown files
cask "obsidian"
# Password manager that keeps all passwords secure behind one password
cask "1password"
# Command-line interface for 1Password
cask "1password-cli"
